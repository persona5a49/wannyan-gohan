{
  "name": "wannyan-pdf-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute wannyan-pdf-orders --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute wannyan-pdf-orders --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
